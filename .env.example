# Public client configuration only. Never put DATABASE_URL/service account secrets here.
EXPO_PUBLIC_APP_MODE=production
EXPO_PUBLIC_API_URL=https://your-management-server.example
EXPO_PUBLIC_STORE_ID=tamaya
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Set your own final unique identifier before the signed production build.
EXPO_IOS_BUNDLE_IDENTIFIER=
# Set only after reviewing business rules, privacy notice and public support page.
RELEASE_BUSINESS_APPROVED=0

# UUID created by EAS init (also configure this in the EAS production environment).
EAS_PROJECT_ID=
