# 開発用ブラウザデモは、このファイルの設定なしで npm run demo から起動できます。
HOST=127.0.0.1
PORT=3001
DATABASE_PATH=./data/tamaya.sqlite
STORE_ID=tamaya
STORE_NAME=むさしの玉屋
# 運営者が作成したFirebaseプロジェクトのID
FIREBASE_PROJECT_ID=your-firebase-project-id
# 秘密値は自分で生成します。例: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
QR_SIGNING_SECRET=
# 管理用認証情報はリポジトリ外へ保管。Google Cloudでは実行環境のADCも利用できます。
# GOOGLE_APPLICATION_CREDENTIALS=C:/private/firebase-admin.json
# ブラウザ接続先を必要なものだけ指定（カンマ区切り）。ネイティブアプリはCORS対象外です。
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081
