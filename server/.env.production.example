# Server-only secrets. Save as server/.env.production; never commit or put in Expo.
APP_ENV=production
AUTH_MODE=firebase
HOST=0.0.0.0
PORT=3001
FIREBASE_PROJECT_ID=tamayaapp
# Runtime login with tamaya_api role only (not postgres admin), generated by db:provision.
DATABASE_URL=
# Schema migration/initial owner setup only. Remove from the hosted API environment.
# Public connection details confirmed by the owner; the password is NOT included.
DATABASE_MIGRATION_URL=postgresql://postgres.ohpbgirqcfxinhntmavk:[YOUR-PASSWORD]@aws-0-ap-northeast-2.pooler.supabase.com:5432/postgres
# Generate using: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
QR_SIGNING_SECRET=
# Optional on Render: the server also reads the built-in RENDER_EXTERNAL_URL.
PUBLIC_BASE_URL=https://tamayaapp.onrender.com
# Empty is sufficient for the native iPhone app. Browser origin(s) require explicit HTTPS URLs.
CORS_ORIGINS=
# 0 for direct access. Render blueprint uses 1; verify the provider's trusted proxy chain.
TRUST_PROXY_HOPS=0
GOOGLE_APPLICATION_CREDENTIALS=
# Set only if the database TLS chain requires the Supabase-provided CA file.
DATABASE_CA_PATH=
STORE_CONFIG_PATH=config/tamaya.json
