{
  "name": "tamaya-management-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "demo": "tsx src/index.ts --demo",
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "owner": "tsx src/owner.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "production:dev": "tsx src/production/index.ts",
    "production": "node dist/server/src/production/index.js",
    "db:migrate": "tsx src/production/migrate.ts",
    "owner:production": "tsx src/production/owner.ts",
    "db:provision": "tsx src/production/provision.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.2.0",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.12.7",
    "firebase-admin": "^14.5.0",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.23.1",
    "tsx": "^4.20.6",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  }
}
