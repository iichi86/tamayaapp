{
  "name": "tamaya-members-demo",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "export:web": "expo export --platform web",
    "export:ios": "expo export --platform ios",
    "server:setup": "npm --prefix server ci",
    "server:demo": "npm --prefix server run demo",
    "server:test": "npm --prefix server test",
    "server:test:browser": "playwright test --config server/playwright.config.ts",
    "start:demo": "node scripts/expo.mjs --demo",
    "web:demo": "node scripts/expo.mjs --demo --web",
    "server:production:dev": "npm --prefix server run production:dev",
    "production:check": "node scripts/release-check.mjs",
    "eas-build-pre-install": "node scripts/release-check.mjs --build",
    "local:setup": "npm --prefix tools ci",
    "local": "node scripts/local-services.mjs",
    "test:production:browser": "playwright test --config production.playwright.config.ts",
    "test:server:postgres": "node scripts/test-postgres.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~58.0.22",
    "expo-camera": "~58.0.14",
    "expo-crypto": "~58.0.7",
    "expo-status-bar": "~58.0.4",
    "firebase": "^12.19.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.10.1",
    "react-native-svg": "15.16.0",
    "react-native-web": "~0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.3.0",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vitest": "^5.0.5"
  },
  "engines": {
    "node": ">=24.3.0"
  }
}
