{
  "name": "tamaya-members-demo",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:browser": "playwright test",
    "export:web": "expo export --platform web",
    "export:ios": "expo export --platform ios",
    "server:setup": "npm --prefix server ci",
    "server:demo": "npm --prefix server run demo",
    "server:test": "npm --prefix server test",
    "server:test:browser": "playwright test --config server/playwright.config.ts"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~57.0.31",
    "expo-camera": "~57.0.6",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-qrcode-svg": "^6.3.26",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/pngjs": "^6.0.5",
    "@types/react": "~19.2.2",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "typescript": "~6.0.3",
    "vitest": "^3.2.4"
  }
}
